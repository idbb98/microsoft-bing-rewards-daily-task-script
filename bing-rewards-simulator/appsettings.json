{
  // 浏览器路径配置
  // 说明：指定要使用的浏览器可执行文件路径
  // 示例：
  // - 夸克浏览器: "C:\\Users\\User\\AppData\\Local\\Programs\\Quark\\quark.exe"
  // - Chrome浏览器: "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
  // - 留空: 使用系统默认浏览器
  "BrowserPath": "C:\\Users\\User\\AppData\\Local\\Programs\\Quark\\quark.exe",
  
  // 搜索次数配置
  // 说明：指定要执行的搜索次数
  // 取值范围：正整数
  "SearchCount": 10,
  
  // 是否使用API获取搜索词
  // 说明：true - 使用在线API获取实时热点词，false - 使用本地词库
  // 建议：true（可获取更丰富的搜索词）
  "UseApiSearchWords": true,
  
  // 是否随机加词
  // 说明：是否在搜索词中随机添加字符，增加搜索词的多样性
  // 示例："人工智能" → "人工1智能"
  "RandomAddSearchWords": false,
  
  // 随机加词因子
  // 说明：控制加词的概率（0-1之间的小数）
  // 值越大，加词的概率越高
  "RandomAddSearchWordsFactor": 0.3,
  
  // 是否随机截词
  // 说明：是否随机截取搜索词的一部分
  // 示例："人工智能发展" → "人工智能"
  "RandomCutSearchWords": false,
  
  // 随机截词因子
  // 说明：控制截取的概率（0-1之间的小数）
  // 值越大，截词的概率越高
  "RandomCutSearchWordsFactor": 0.2,
  
  // 暂停间隔最小值
  // 说明：每执行多少次搜索后暂停一次的最小值
  // 取值范围：正整数
  "PauseIntervalMin": 666,
  
  // 暂停间隔最大值
  // 说明：每执行多少次搜索后暂停一次的最大值
  // 取值范围：正整数（大于等于PauseIntervalMin）
  "PauseIntervalMax": 999,
  
  // 暂停时间最小值
  // 说明：每次暂停的最短时间（毫秒）
  // 示例：600000 = 10分钟
  "PauseTimeMin": 600000,
  
  // 暂停时间最大值
  // 说明：每次暂停的最长时间（毫秒）
  // 示例：1800000 = 30分钟
  "PauseTimeMax": 1800000,
  
  // 搜索最小延迟
  // 说明：两次搜索之间的最短等待时间（毫秒）
  // 建议：5000-10000（避免操作过快被检测）
  "MinDelay": 2000,
  
  // 搜索最大延迟
  // 说明：两次搜索之间的最长等待时间（毫秒）
  // 建议：10000-20000（模拟真实用户行为）
  "MaxDelay": 5000
}