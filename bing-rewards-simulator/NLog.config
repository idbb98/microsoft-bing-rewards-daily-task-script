<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs\internal-nlog.txt">

  <extensions>
    <add assembly="NLog" />
  </extensions>

  <variable name="logDirectory" value="logs" />

  <targets>
    <!-- 控制台输出 -->
    <target xsi:type="Console" name="console"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss} ${level:uppercase=true} ${message} ${exception:format=tostring}" />

    <!-- 每日文件输出 -->
    <target xsi:type="File" name="file"
            fileName="${logDirectory}\${date:format=yyyy-MM-dd}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss} ${level:uppercase=true} ${message} ${exception:format=tostring}"
            archiveFileName="${logDirectory}\archive\${date:format=yyyy-MM-dd}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />
  </targets>

  <rules>
    <!-- 所有日志同时输出到控制台和文件 -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>